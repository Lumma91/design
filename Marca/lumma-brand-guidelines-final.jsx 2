function ColorSwatch({ color, isLarge }) {
  const [copied, setCopied] = useState(false);
  return (
    <div
      className="cursor-pointer group"
      onClick={() => {
        navigator.clipboard?.writeText(color.hex);
        setCopied(true);
        setTimeout(() => setCopied(false), 1500);
      }}
    >
      <div
        className="rounded-xl transition-transform duration-200 group-hover:scale-105 relative overflow-hidden"
        style={{
          backgroundColor: color.hex,
          height: isLarge ? 100 : 72,
          border: color.hex === "#080808" || color.hex === "#111111" ? `1px solid ${C.dim}` : "none",
          boxShadow: `0 0 30px ${color.hex}15`,
        }}
      >
        {copied && (
          <div className="absolute inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm">
            <span className="text-xs font-bold" style={{ color: C.green }}>Copiado</span>
          </div>
        )}
      </div>
      <p className="text-xs font-bold mt-2" style={{ color: C.white, fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
        {color.name}
      </p>
      <p className="text-xs font-mono" style={{ color: C.dim }}>{color.hex}</p>
      <p className="text-xs mt-0.5" style={{ color: C.gray, fontFamily: "'Plus Jakarta Sans', sans-serif" }}>{color.role}</p>
    </div>
  );
}

